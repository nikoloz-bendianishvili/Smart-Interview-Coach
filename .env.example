# Copy this file to .env and fill in real values before running
# `docker compose up` (or before setting these as env vars to run the app
# without Docker). .env is gitignored - never commit real secrets.

# --- Required ---

# MySQL root password (used both by the mysql container and by the app's
# datasource connection).
DB_PASSWORD=changeme

# HMAC-SHA256 signing key for JWTs. Must be Base64-encoded and decode to
# at least 256 bits. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=changeme-base64-encoded-secret

# Transactional email provider (Brevo) - used for verification emails.
# A placeholder value is fine for local/demo use if you never trigger
# registration emails.
BREVO_API_KEY=changeme
SENDER_EMAIL=changeme@example.com

# --- Optional ---

# JWT lifetime in ms (default 86400000 = 24h).
# JWT_EXPIRATION=86400000

# Frontend origin, used in outgoing email links (default http://localhost:8080).
# FRONTEND_URL=http://localhost:5173

# Judge0 (code-execution grading). Leave empty to skip live code grading.
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=

# Anthropic API (AI grading of open-ended answers). Leave empty to skip
# live AI grading.
# AI_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# Populate the database with demo topics/questions/users on startup.
# Already forced to "true" inside docker-compose.yml; only needed here
# when running without Docker.
# SEED_ENABLED=true
