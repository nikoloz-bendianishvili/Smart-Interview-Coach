config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true

# JudgeService and TranscriptionService each take one of two RestClient beans (see Judge0Config /
# TranscriptionConfig) via a field-level @Qualifier - Lombok doesn't copy Spring's @Qualifier onto
# the generated @RequiredArgsConstructor parameter by default, so it's listed here explicitly.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
